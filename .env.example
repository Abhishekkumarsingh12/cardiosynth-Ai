# =============================================================================
# CardioSynth AI — environment template
# Copy relevant lines into backend/.env (FastAPI loads from backend working dir).
# =============================================================================

# Required in production: strong random secret (e.g. openssl rand -hex 32)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# JWT lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database: leave empty for SQLite (file backend/cardiosynth.db).
# PostgreSQL example (requires psycopg):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/cardiosynth

DATABASE_URL=

# Uploaded CSV storage (relative to backend/ working directory)
UPLOADS_DIR=uploads

# Comma-separated origins for browser CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Must match uvicorn --host / --port so startup logs and JSON on / show correct links
# API_ADVERTISED_HOST=127.0.0.1
# API_ADVERTISED_PORT=8000
# Optional: set CARDIOSYNTH_BUILD=staging-2026-04-05 to identify this deploy in logs

# ECG TensorFlow classifier — install TensorFlow for real inference:
#   pip install -r requirements-tensorflow.txt   (or tensorflow>=2.13 on your platform)
# Place trained Keras model at backend/ml_models/arrhythmia_model.h5
# ECG_CLASSIFIER_MODEL_PATH=
# ECG_DEFAULT_SAMPLING_RATE_HZ=360
# ECG_CLASSIFIER_INPUT_LENGTH=187
# Default false: classifier must load or /api/ecg uploads return HTTP 503 (no fake success).
# ENABLE_MOCK_INFERENCE=false
# SKIP_CLASSIFIER_AUTO_BOOTSTRAP=false
# ECG_AUTO_PREPARE_DATASET=false   # if true, runs setup_dataset when NPZ missing (downloads data)
# ECG_CLASSIFIER_BOOTSTRAP_QUICK=1 # 0 for full training on first boot (slow)
# ECG_CLASSIFIER_STRICT=0          # 1 = raise if training + dummy both fail

# DDPM synthetic generator (optional path; default backend/ml_models/synthetic_generator_model.h5)
# ECG_DDPM_MODEL_PATH=
# ECG_DDPM_SIGNAL_LENGTH=128
# ECG_DDPM_NUM_TIMESTEPS=200
# ECG_DDPM_SCHEDULE=linear
# If true: synthetic endpoint returns 503 when DDPM weights missing or fail (no parametric strip).
# SYNTHETIC_REQUIRE_DDPM=false
# If false: when DDPM unavailable, POST generate-synthetic returns 503 immediately.
# SYNTHETIC_PROCEDURAL_ENABLED=true

# -----------------------------------------------------------------------------
# Assistant LLM (optional): OpenAI-compatible Chat Completions
# If LLM_ENABLED is false or OPENAI_API_KEY is empty, chat uses the built-in rule-based assistant.
# LLM_ENABLED=false
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=60
# CHAT_MEMORY_MAX_TURNS=10
# -----------------------------------------------------------------------------
# Frontend (optional): only if you call API by absolute URL instead of Vite proxy
# VITE_API_URL=http://127.0.0.1:8000
# -----------------------------------------------------------------------------
